# ── Client environment (Vite) ──────────────────────────────
# Copy to .env.local and fill in real values.

# Backend API base URL (include trailing /api)
VITE_API_URL=https://feroze-api.onrender.com/api

# Cloudinary (public cloud name only — never put the secret here)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name

# WhatsApp business number (digits only, country code first)
VITE_WHATSAPP_NUMBER=918355821370

# Instagram handles (no @)
VITE_INSTAGRAM_INTERIORS=feroze.arch
VITE_INSTAGRAM_AUTOMOTIVE=ferozeautomotivedecor
